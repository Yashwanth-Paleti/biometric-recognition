# Environment Configuration
APP_ENV=development

# Biometric Storage Engine: 'local' (JSON) or 'postgres' (PostgreSQL + pgvector)
BIOMETRIC_STORAGE=postgres

# PostgreSQL Connection URL (psycopg3 format)
# Placeholder format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/biometrics
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Biometric Matching Engine Settings
# Default Euclidean (L2) Distance Threshold (e.g. 0.85)
BIOMETRIC_MATCH_THRESHOLD=0.85

# InsightFace / ONNX Runtime Model
MODEL_NAME=buffalo_l
MODEL_VERSION=1.0.0
EXECUTION_PROVIDER=CPUExecutionProvider
DETECTION_THRESHOLD=0.5
ENFORCE_SINGLE_FACE_ENROLLMENT=true

# Storage Settings (used when BIOMETRIC_STORAGE=local)
LOCAL_STORAGE_PATH=data/biometric_templates.json
LEGACY_PICKLE_PATH=legacy/encodings/face_encodings.pickle

# REST API & Networking
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Application Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# Stage 3 Security, Liveness, and Hardening Configuration
# =============================================================================

# Liveness / Presentation Attack Detection
LIVENESS_ENABLED=true
LIVENESS_THRESHOLD=0.40
LIVENESS_METHOD=passive_texture_frequency_v1

# JWT Authentication & Authorization (Replace with strong random secrets in production)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-secure-password

# Rate Limiting & Brute-Force Abuse Protections (Requests per minute per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_VERIFY_PER_MINUTE=60
RATE_LIMIT_IDENTIFY_PER_MINUTE=30
RATE_LIMIT_ENROLL_PER_MINUTE=20

